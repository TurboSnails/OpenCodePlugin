{
  "name": "opencode-cli-dispatch",
  "version": "1.2.1",
  "description": "OpenCode plugin for delegating conversations to external CLI agents (Claude, Codex, etc.)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cli-dispatch": "./dist/doctor/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:dev": "CLI_DISPATCH_DEV=1 bun test",
    "test:isolated": "HOME=$(mktemp -d) bun test",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "latest",
    "@opencode-ai/plugin": "1.18.4"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "files": [
    "dist",
    "cli-dispatch.config.json"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "cli",
    "dispatch",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurboSnails/OpenCodePlugin.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
