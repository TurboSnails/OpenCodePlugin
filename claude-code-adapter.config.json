{
  "delegates": {
    "codex": {
      "binary": "codex",
      "parser": "codex",
      "startArgs": [
        "exec",
        "--json",
        "-c",
        "sandbox_mode=workspace-write",
        "--skip-git-repo-check",
        "--",
        "{prompt}"
      ],
      "replyArgs": [
        "exec",
        "resume",
        "--json",
        "-c",
        "sandbox_mode=workspace-write",
        "--skip-git-repo-check",
        "--",
        "{externalId}",
        "{prompt}"
      ]
    },
    "opencode": {
      "binary": "opencode",
      "parser": "opencode",
      "startArgs": ["run", "--format", "json", "--", "{prompt}"],
      "replyArgs": ["run", "--format", "json", "-s", "{externalId}", "-c", "--", "{prompt}"]
    }
  },
  "verifiedModels": ["claude-*"]
}
